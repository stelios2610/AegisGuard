/* WatchGuard-inspired dark theme */

QMainWindow, QWidget {
    background-color: #1e2329;
    color: #e0e6ed;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}

QMenuBar {
    background-color: #161b22;
    color: #e0e6ed;
    border-bottom: 1px solid #30363d;
}
QMenuBar::item:selected { background-color: #c0392b; }
QMenu {
    background-color: #161b22;
    border: 1px solid #30363d;
}
QMenu::item:selected { background-color: #c0392b; }

/* Sidebar navigation */
QListWidget#sidebar {
    background-color: #161b22;
    border: none;
    border-right: 1px solid #30363d;
    font-size: 14px;
    outline: none;
}
QListWidget#sidebar::item {
    padding: 12px 16px;
    border-left: 3px solid transparent;
    color: #8b949e;
}
QListWidget#sidebar::item:selected {
    background-color: #1e2329;
    color: #ffffff;
    border-left: 3px solid #c0392b;
}
QListWidget#sidebar::item:hover {
    background-color: #21262d;
    color: #e0e6ed;
}

/* Cards / panels */
QFrame#card {
    background-color: #21262d;
    border: 1px solid #30363d;
    border-radius: 8px;
}

/* Tables */
QTableWidget {
    background-color: #161b22;
    alternate-background-color: #1e2329;
    border: 1px solid #30363d;
    gridline-color: #30363d;
    selection-background-color: #c0392b;
    selection-color: #ffffff;
    border-radius: 4px;
}
QTableWidget::item { padding: 4px 8px; }
QHeaderView::section {
    background-color: #21262d;
    color: #8b949e;
    border: none;
    border-bottom: 1px solid #30363d;
    border-right: 1px solid #30363d;
    padding: 6px 8px;
    font-weight: bold;
    font-size: 12px;
    text-transform: uppercase;
}

/* Buttons */
QPushButton {
    background-color: #c0392b;
    color: #ffffff;
    border: none;
    border-radius: 5px;
    padding: 7px 16px;
    font-weight: bold;
}
QPushButton:hover { background-color: #e74c3c; }
QPushButton:pressed { background-color: #a93226; }
QPushButton:disabled { background-color: #30363d; color: #8b949e; }

QPushButton#secondary {
    background-color: #21262d;
    color: #e0e6ed;
    border: 1px solid #30363d;
}
QPushButton#secondary:hover { background-color: #30363d; }

QPushButton#success {
    background-color: #27ae60;
}
QPushButton#success:hover { background-color: #2ecc71; }

QPushButton#danger {
    background-color: #8b0000;
}
QPushButton#danger:hover { background-color: #c0392b; }

/* Input fields */
QLineEdit, QComboBox, QSpinBox, QTextEdit {
    background-color: #0d1117;
    color: #e0e6ed;
    border: 1px solid #30363d;
    border-radius: 5px;
    padding: 6px 10px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border-color: #c0392b;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background-color: #161b22;
    border: 1px solid #30363d;
    selection-background-color: #c0392b;
}

/* Labels */
QLabel#heading {
    font-size: 20px;
    font-weight: bold;
    color: #ffffff;
}
QLabel#subheading {
    font-size: 13px;
    color: #8b949e;
}
QLabel#stat_value {
    font-size: 32px;
    font-weight: bold;
    color: #ffffff;
}
QLabel#stat_label {
    font-size: 12px;
    color: #8b949e;
    text-transform: uppercase;
}
QLabel#badge_block {
    background-color: #c0392b;
    color: white;
    border-radius: 3px;
    padding: 2px 6px;
    font-size: 11px;
    font-weight: bold;
}
QLabel#badge_allow {
    background-color: #27ae60;
    color: white;
    border-radius: 3px;
    padding: 2px 6px;
    font-size: 11px;
    font-weight: bold;
}

/* Scrollbars */
QScrollBar:vertical {
    background: #161b22;
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #30363d;
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover { background: #8b949e; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: #161b22;
    height: 8px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #30363d;
    border-radius: 4px;
    min-width: 20px;
}
QScrollBar::handle:horizontal:hover { background: #8b949e; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* Tab widget */
QTabWidget::pane {
    border: 1px solid #30363d;
    background-color: #1e2329;
}
QTabBar::tab {
    background-color: #161b22;
    color: #8b949e;
    padding: 8px 16px;
    border: none;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:selected {
    color: #ffffff;
    border-bottom: 2px solid #c0392b;
    background-color: #1e2329;
}
QTabBar::tab:hover { color: #e0e6ed; }

/* Status bar */
QStatusBar {
    background-color: #161b22;
    color: #8b949e;
    border-top: 1px solid #30363d;
}

/* Group boxes */
QGroupBox {
    border: 1px solid #30363d;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 8px;
    color: #8b949e;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #8b949e;
}

/* Checkboxes */
QCheckBox { color: #e0e6ed; spacing: 8px; }
QCheckBox::indicator {
    width: 16px; height: 16px;
    border: 1px solid #30363d;
    border-radius: 3px;
    background-color: #0d1117;
}
QCheckBox::indicator:checked {
    background-color: #c0392b;
    border-color: #c0392b;
}

/* Progress bar */
QProgressBar {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-radius: 4px;
    text-align: center;
    color: white;
    height: 12px;
}
QProgressBar::chunk {
    background-color: #c0392b;
    border-radius: 4px;
}

/* Tooltips */
QToolTip {
    background-color: #21262d;
    color: #e0e6ed;
    border: 1px solid #30363d;
    padding: 4px 8px;
    border-radius: 4px;
}

/* Splitter */
QSplitter::handle { background-color: #30363d; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical { height: 2px; }
